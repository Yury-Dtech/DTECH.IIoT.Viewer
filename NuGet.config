<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="TelerikNuGetV3" value="https://nuget.telerik.com/v3/index.json" />
  </packageSources>
  <!--
    Na maszynie deweloperskiej źródło Telerik bywa wyłączone globalnie.
    Ta sekcja włącza je z powrotem dla tego repozytorium.
  -->
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
  <!--
    Dane logowania do feedu Telerik NIE są trzymane w repozytorium.
    Ustaw je jednorazowo lokalnie - instrukcja w README.md.
  -->
</configuration>
