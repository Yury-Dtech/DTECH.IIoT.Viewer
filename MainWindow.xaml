<Window x:Class="DTECH.IIoT.Viewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Wpf;assembly=Microsoft.AspNetCore.Components.WebView.Wpf"
        xmlns:components="clr-namespace:DTECH.IIoT.Viewer.Components"
        Title="D-TECH IIoT Viewer" Height="860" Width="1440"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <!--
            BlazorWebView to jedyna zawartość okna - cały interfejs powstaje w Blazorze.
            HostPage wskazuje stronę startową, a RootComponent montuje router aplikacji
            w elemencie o selektorze #app.
        -->
        <blazor:BlazorWebView x:Name="BlazorWebViewHost" HostPage="wwwroot\index.html">
            <blazor:BlazorWebView.RootComponents>
                <blazor:RootComponent Selector="#app" ComponentType="{x:Type components:Routes}" />
            </blazor:BlazorWebView.RootComponents>
        </blazor:BlazorWebView>
    </Grid>
</Window>
