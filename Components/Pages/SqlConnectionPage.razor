@page "/"
@inject ConnectionSettingsStore SettingsStore
@inject SqlDataService SqlData
@inject AppState AppState

<PageTitle>Połączenie SQL · D-TECH IIoT Viewer</PageTitle>

<div class="screen">
    <div class="page-head">
        <div>
            <div class="eyebrow">KONFIGURACJA</div>
            <h1>Połączenie z SQL Server</h1>
            <p>Ustaw źródło danych dla listy kolektorów i wykresów.</p>
        </div>
        <span class="badge">SQL · tylko odczyt</span>
    </div>

    <div class="panel" style="margin-top: 18px;">
        <div class="panel-title">
            <h2>Parametry połączenia</h2>
        </div>
        <div class="panel-body">
            <EditForm Model="_settings" OnValidSubmit="HandleTestConnection">
                <DataAnnotationsValidator />

                <div class="form-grid">
                    <label class="field">
                        <span>Serwer SQL</span>
                        <TelerikTextBox @bind-Value="_settings.Server" Placeholder="np. localhost lub IP\SQLEXPRESS" />
                    </label>

                    <label class="field">
                        <span>Baza danych</span>
                        <TelerikTextBox @bind-Value="_settings.Database" Placeholder="np. IIoT_Viewer" />
                    </label>

                    <label class="field">
                        <span>Uwierzytelnianie</span>
                            <TelerikDropDownList Data="@_authOptions"
                                                 Value="@_isWindowsAuth"
                                                 ValueChanged="@((bool val) => OnAuthTypeChanged(val))"
                                                 ValueExpression="@(() => _isWindowsAuth)"
                                                 ValueField="IsWindows"
                                                 TextField="Name" />
                    </label>

                    <label class="field">
                        <span>Użytkownik (Login)</span>
                        <TelerikTextBox @bind-Value="_settings.Login"
                                        Enabled="@(!_isWindowsAuth)"
                                        Placeholder="@(_isWindowsAuth ? "Domena\\Użytkownik (Windows)" : "sa")" />
                    </label>

                    <label class="field">
                        <span>Hasło</span>
                        <TelerikTextBox @bind-Value="_settings.Password"
                                        Password="true"
                                        Enabled="@(!_isWindowsAuth)"
                                        Placeholder="@(_isWindowsAuth ? "Nie wymagane" : "••••••••")" />
                    </label>

                    <div class="field" style="justify-content: flex-end; align-items: flex-end;">
                        <TelerikButton ButtonType="@ButtonType.Submit"
                                       ThemeColor="@Telerik.Blazor.ThemeConstants.Button.ThemeColor.Primary"
                                       Enabled="@(!_isTesting)">
                            @if (_isTesting)
                            {
                                <span>Łączenie...</span>
                            }
                            else
                            {
                                <span>Testuj i zapisz połączenie</span>
                            }
                        </TelerikButton>
                    </div>
                </div>
            </EditForm>

            @if (_testResult is not null)
            {
                <div class="statusbox @(_testResult.Value.Success ? "ok" : "warn")" style="margin-top: 18px;">
                    <strong>@(_testResult.Value.Success ? "Sukces" : "Błąd połączenia"):</strong> @_testResult.Value.Message
                </div>
            }
        </div>
    </div>

    <div class="notice-line" style="margin-top:18px">
        <span>ℹ</span>
        <span>
            Ustawienia serwera i bazy są zapamiętywane na tym komputerze. Hasło ze względów bezpieczeństwa nie jest zapisywane na dysku.
        </span>
    </div>
</div>

@code {
    private SqlConnectionSettings _settings = new();
    private bool _isWindowsAuth = true;
    private bool _isTesting = false;
    private (bool Success, string Message)? _testResult;

    private readonly List<AuthOption> _authOptions = new()
    {
        new AuthOption { Name = "Uwierzytelnianie Windows", IsWindows = true },
        new AuthOption { Name = "SQL Server Authentication", IsWindows = false }
    };

    protected override void OnInitialized()
    {
        var saved = SettingsStore.Load();
        if (saved != null)
        {
            _settings = saved;
            _isWindowsAuth = _settings.AuthMode == SqlAuthMode.Windows;
        }
        else
        {
            _settings.AuthMode = SqlAuthMode.Windows;
        }
    }

    private void OnAuthTypeChanged(bool isWindows)
    {
        _isWindowsAuth = isWindows;
        _settings.AuthMode = isWindows ? SqlAuthMode.Windows : SqlAuthMode.SqlServer;
        if (isWindows)
        {
            _settings.Login = string.Empty;
            _settings.Password = string.Empty;
        }
    }

    private async Task HandleTestConnection()
    {
        _isTesting = true;
        _testResult = null;

        _settings.AuthMode = _isWindowsAuth ? SqlAuthMode.Windows : SqlAuthMode.SqlServer;

        var result = await SqlData.TestConnectionAsync(_settings);
        _testResult = result;

        if (result.Success)
        {
            AppState.Connection = _settings;
            SettingsStore.Save(_settings);
        }
        else
        {
            AppState.Connection = null;
        }

        _isTesting = false;
    }

    private class AuthOption
    {
        public string Name { get; set; } = string.Empty;
        public bool IsWindows { get; set; }
    }
}
